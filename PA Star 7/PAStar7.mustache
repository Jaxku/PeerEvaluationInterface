<style>
    .peer-assessment {
        max-width: 1000px;
        margin: 2rem auto;
        padding: 2rem;
        background: #ffffff;
        border: 1px solid #dee2e6;
        border-radius: 12px;
        color: #212529;
    }

    .peer-assessment__heading {
        margin-bottom: 0.75rem;
        font-size: 1.75rem;
        font-weight: 600;
    }

    .peer-assessment__description {
        margin-bottom: 2rem;
        color: #495057;
        line-height: 1.6;
    }

    .peer-assessment__peer {
        padding: 1.5rem 0;
        border-top: 1px solid #dee2e6;
    }

    .peer-assessment__peer-name {
        margin-bottom: 1.25rem;
        font-size: 1.25rem;
        font-weight: 600;
    }

    .peer-assessment__rating-list {
        overflow-x: auto;
        padding: 0.5rem 0 1rem;
    }

    .peer-assessment__ratings {
        display: grid;
        grid-template-columns: repeat(7, minmax(0, 1fr));
        gap: 0.5rem;
        width: 100%;
    }

    .peer-assessment__rating {
        display: grid;
        grid-template-rows: 3.5rem 2rem 1.5rem;
        justify-items: center;
        align-items: center;
        text-align: center;
        gap: 0.5rem;
        min-width: 0;
    }

    .peer-assessment__descriptor {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        height: 100%;
        font-size: 0.75rem;
        line-height: 1.25;
        color: #495057;
        overflow-wrap: anywhere;
    }

    .peer-assessment__radio {
        appearance: none;
        -webkit-appearance: none;
        display: block;
        width: 1.25rem;
        height: 1.25rem;
        margin: 0;
        border: 2px solid #adb5bd;
        border-radius: 50%;
        background-color: #ffffff;
        cursor: pointer;
        flex-shrink: 0;
        transition: background-color 0.15s ease,
        border-color 0.15s ease;
    }

    .peer-assessment__radio:checked {
        border-color: #2596be;
        background-color: #2596be;
        box-shadow: inset 0 0 0 3px #ffffff;
    }

    .peer-assessment__radio:focus-visible {
        outline: 2px solid #2596be;
        outline-offset: 3px;
    }

    .peer-assessment__value {
        font-size: 0.85rem;
        color: #6c757d;
        line-height: 1.5rem;
    }

    .peer-assessment__actions {
        display: flex;
        justify-content: flex-end;
        margin-top: 1.5rem;
        padding-top: 1.5rem;
        border-top: 1px solid #dee2e6;
    }

    .peer-assessment__confirm {
        padding: 0.65rem 1.5rem;
        border: 1px solid #2596be;
        border-radius: 6px;
        background: #2596be;
        color: #ffffff;
        font-size: 1rem;
        font-weight: 500;
        cursor: pointer;
    }

    .peer-assessment__confirm:hover {
        background: #207fa1;
        border-color: #207fa1;
    }

    @media (max-width: 800px) {
        .peer-assessment__ratings {
            grid-template-columns: repeat(7, minmax(65px, 1fr));
            min-width: 500px;
        }

        .peer-assessment__rating-list {
            overflow-x: auto;
        }
    }

    @media (max-width: 600px) {
        .peer-assessment {
            padding: 1rem;
        }

        .peer-assessment__heading {
            font-size: 1.4rem;
        }
    }
</style>

<section class="peer-assessment">

    <h2 class="peer-assessment__heading">
        {{assessment_title}}
    </h2>

    <p class="peer-assessment__description">
        {{assessment_description}}
    </p>

    {{#peers}}
        <div class="peer-assessment__peer">

            <h3 class="peer-assessment__peer-name">
                {{name}}
            </h3>

            <div class="peer-assessment__rating-list">
                <div
                        class="peer-assessment__ratings"
                        role="group"
                        aria-label="Rate {{name}}">

                    {{#ratings}}
                        <div class="peer-assessment__rating">

                            <span class="peer-assessment__descriptor">
                                {{descriptor}}
                            </span>

                            <input
                                    class="peer-assessment__radio"
                                    type="radio"
                                    name="peer_rating_{{name}}"
                                    id="peer-rating-{{name}}-{{value}}"
                                    value="{{value}}"
                                    aria-label="{{value}} out of 7: {{descriptor}}">

                            <label
                                    class="peer-assessment__value"
                                    for="peer-rating-{{name}}-{{value}}">
                                {{value}}
                            </label>

                        </div>
                    {{/ratings}}

                </div>
            </div>

        </div>
    {{/peers}}

    <div class="peer-assessment__actions">
        <button
                type="button"
                class="peer-assessment__confirm">
            Confirm
        </button>
    </div>

</section>