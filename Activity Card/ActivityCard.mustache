{{! Extracted from playground.mustache; retained there for the combined demo. }}
<div data-region="uisandbox-activitycard">
{{#activitycard}}
      <div class="mt-5 mb-5" data-region="uisandbox-activity-card">
          <div class="card rounded-3"
               style="border: 1px solid #e3e6e8; background-color: #f8f9fa;">

              <div class="card-body d-flex align-items-start gap-3 py-3 px-4">

                  {{! Activity icon }}
                  <i class="{{iconclass}} fs-3 flex-shrink-0"
                     style="{{colorstyle}}"
                     aria-hidden="true"></i>

                  <div>
                      {{! Activity title }}
                      <a href="{{url}}"
                         class="text-dark text-decoration-none fw-medium">
                          {{title}}
                      </a>

                      {{! Activity availability dates }}
                      <div class="small text-muted mt-2 d-flex flex-wrap gap-1">
                          <strong>Opened:</strong>
                          <span>{{opened}}</span>

                          <span class="mx-1">·</span>

                          <strong>Due:</strong>
                          <span>{{due}}</span>
                      </div>
                  </div>

              </div>
          </div>
      </div>
  {{/activitycard}}

</div>
