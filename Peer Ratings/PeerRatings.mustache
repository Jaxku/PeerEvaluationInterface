{{! Extracted from playground.mustache; retained there for the combined demo. }}
<div data-region="uisandbox-peerratings">
{{#rating}}
    <div class="mt-5 mb-5" data-region="uisandbox-rating-scale">
        <h5 class="mb-1">{{title}}</h5>
        <p class="text-muted small mb-3">{{help}}</p>

        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <caption class="visually-hidden">{{title}}</caption>
                <thead>
                    <tr>
                        <th scope="col"><span class="visually-hidden">Name</span></th>
                        {{#scale}}
                            <th scope="col" class="text-center">
                                <i class="fa-solid {{icon}} fs-4" style="{{colorstyle}}" aria-hidden="true"></i>
                                <span class="d-block small fw-normal">{{label}}</span>
                            </th>
                        {{/scale}}
                    </tr>
                </thead>
                <tbody>
                    {{#rows}}
                        <tr>
                            <th scope="row" class="text-nowrap {{#is_self}}fw-bold{{/is_self}}{{^is_self}}fw-normal{{/is_self}}">
                                {{#is_self}}
                                    <i class="fa-solid fa-user me-2" aria-hidden="true"></i>
                                {{/is_self}}
                                {{name}}
                            </th>
                            {{#options}}
                                <td class="text-center">
                                    <input type="radio" class="form-check-input fs-5 m-0"
                                           name="{{key}}" id="{{id}}" value="{{value}}"
                                           aria-label="{{arialabel}}">
                                </td>
                            {{/options}}
                        </tr>
                    {{/rows}}
                </tbody>
            </table>
        </div>
    </div>
{{/rating}}

</div>
